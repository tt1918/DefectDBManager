<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="FileServerLog" type="log4net.Appender.RollingFileAppender">
    <file value="C:\Coss\Log\"/>
    <appendToFile value="true"/>
    <datePattern value="yyyyMMdd'_FILESERVER_LOG.txt'"/>
    <encoding value="utf-8" />
    <staticLogFileName value="false"/>
    <rollingStyle value="Date"/>
    <!--<maxSizeRollBackups value ="100"/>
    <maximumFileSize value ="10MB"/>-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%d [%t] %-5p - %m%n"/>
    </layout>
  </appender>
  <logger name ="FileServer">
    <level value="DEBUG"/>
    <appender-ref ref="FileServerLog"/>
  </logger>
  <appender name="NetworkLog" type="log4net.Appender.RollingFileAppender">
