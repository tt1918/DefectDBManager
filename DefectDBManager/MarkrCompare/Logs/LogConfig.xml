    <!--<maxSizeRollBackups value ="100"/>
    <maximumFileSize value ="10MB"/>-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%d [%t] %-5p %c - %m%n"/>
    </layout>
  </appender>
  <logger name ="Network">
    <level value="DEBUG"/>
    <appender-ref ref="NetworkLog"/>
  </logger>
